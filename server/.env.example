PUBLIC_URL=http://localhost:3000
LLMROAM_URL=http://localhost:33002
# Optional full OAuth authorization page URL; defaults to LLMROAM_URL/api/oauth-provider/authorize.
OAUTH_AUTHORIZE_URL=http://www.llmroam.com/api/oauth-provider/authorize
OAUTH_CLIENT_ID=infinite-canvas
# Generate a random client secret; configure the same value in LLMRoam.
OAUTH_CLIENT_SECRET=
# Generate 32 random bytes and encode as 64 hexadecimal characters. Keep stable across restarts.
ENCRYPTION_KEY=
DATABASE_URL=postgres://canvas:CHANGE_ME@localhost:5432/canvas
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=canvas
S3_ACCESS_KEY=
S3_SECRET_KEY=
MAX_MEDIA_BYTES=536870912
USER_STORAGE_BYTES=2147483648
SESSION_SECONDS=2592000
MEDIA_URL_SECONDS=600
OAUTH_FLOW_SECONDS=300
PORT=3001
HOST=127.0.0.1
